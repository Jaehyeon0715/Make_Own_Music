# AI Composer - GPU PC backend .env (layout B, Provider fixed to Ollama)
# install_server.ps1 replaces __OLLAMA_MODEL__ / __DEMUCS_DEVICE__ and writes backend\.env.

# ── AI Provider (fixed) ──────────────────────────────
AI_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=__OLLAMA_MODEL__

# ── ACE-Step (same PC, localhost only) ───────────────
ACESTEP_URL=http://localhost:8001
ACESTEP_CLIENT_TIMEOUT=1800

# ── Demucs stem separation ───────────────────────────
DEMUCS_DEVICE=__DEMUCS_DEVICE__
DEMUCS_MODEL=htdemucs
DEMUCS_STEMS=drums,bass,other

# ── Data paths (GPU PC local disk) ───────────────────
DB_PATH=./sessions.db
OUTPUTS_DIR=./outputs
SESSION_TTL_HOURS=24
MAX_MIX_VERSIONS=10

# ── Network / CORS ───────────────────────────────────
# Frontend is served from the same origin (8080) as the backend, so CORS is effectively unused.
# Only add origins when connecting directly from another device's browser (different origin).
CORS_ORIGINS=http://localhost:8080

# ── Auth ─────────────────────────────────────────────
# Assumes a trusted LAN / Tailscale, so leave unset.
# WARNING: if set, the frontend does not send X-API-Key, so its own calls return 401
# (patch the frontend first).
# API_KEY=
