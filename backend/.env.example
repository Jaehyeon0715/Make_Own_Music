# AI provider: claude | openai | gemini | ollama
AI_PROVIDER=ollama

# Provider API keys. Fill only the provider you use.
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ACE-Step server
ACESTEP_URL=http://localhost:8001

# Optional API auth. Leave blank to disable X-API-Key checks.
API_KEY=

# Paths
DB_PATH=sessions.db
OUTPUTS_DIR=outputs

# Server
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
SESSION_TTL_HOURS=24
MAX_MIX_VERSIONS=10
