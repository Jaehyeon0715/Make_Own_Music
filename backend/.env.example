# AI provider: claude | openai | gemini | ollama
AI_PROVIDER=ollama

# Provider API keys. Fill only the provider you use.
CLAUDE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ACE-Step server
ACESTEP_URL=http://localhost:8001
# Optional explicit model ID (default auto-detected from /health)
# ACESTEP_MODEL=acestep/acestep-v15-turbo
# Client-side timeout in seconds (default 1800 = 30 min)
# ACESTEP_CLIENT_TIMEOUT=1800

# Optional API auth. Leave blank to disable X-API-Key checks.
API_KEY=

# Paths
DB_PATH=sessions.db
OUTPUTS_DIR=outputs

# Server (launcher uses port 8080)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
SESSION_TTL_HOURS=24
MAX_MIX_VERSIONS=10
